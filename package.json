{
  "name": "secure-notes-backend",
  "version": "1.0.0",
  "description": "REST API for a secure note-taking app (Express, MongoDB/Mongoose, JWT, RBAC)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/devMemory.js",
    "seed": "node scripts/seed.js",
    "sync-indexes": "node scripts/syncIndexes.js",
    "explain": "node scripts/explain.js",
    "test": "node --test --test-timeout=300000 test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
